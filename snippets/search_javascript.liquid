<script>
  // predictive-search
  class PredictiveSearch extends HTMLElement {
    constructor() {
      super();
      this.input = this.querySelector('input[type="search"]');
      this.predictiveSearchResults = this.querySelector('#predictive-search');
      this.input.addEventListener('input', this.debounce((event) => {
        this.onChange(event);
      }, 300).bind(this));
    }
    onChange() {
      const searchTerm = this.input.value.trim();
      if (!searchTerm.length) {
        this.close();
        return;
      }
      this.getSearchResults(searchTerm);
    }
    getSearchResults(searchTerm) {
      fetch(`{% unless request.locale.root_url == '/' %}{{ request.locale.root_url }}{% endunless %}/search/suggest?q=${searchTerm}&amp;section_id=predictive_search`)
        .then((response) => {
        if (!response.ok) {
          var error = new Error(response.status);
          this.close();
          throw error;
        }
        return response.text();
      })
        .then((text) => {
        const resultsMarkup = new DOMParser().parseFromString(text, 'text/html').querySelector('#shopify-section-predictive_search').innerHTML;
        this.predictiveSearchResults.innerHTML = resultsMarkup;
        this.open();
      })
        .catch((error) => {
        this.close();
        throw error;
      });
    }
    open() {
      this.predictiveSearchResults.style.display = 'block';
    }
    close() {
      this.predictiveSearchResults.style.display = 'none';
    }
    debounce(fn, wait) {
      let t;
      return (...args) => {
        clearTimeout(t);
        t = setTimeout(() => fn.apply(this, args), wait);
      };
    }
  }
  customElements.define('predictive-search', PredictiveSearch);
</script>
    <script>
  const CART_LIMIT = 8;
  function updateCartLimit(itemCount) {
    const addToCartBtn = document.querySelector('.addtocart_holder');
    const productCardBtns = document.querySelectorAll('.add-to-c');
    const input = document.querySelector('#quantity');
    const remaining = CART_LIMIT - itemCount;
    if (addToCartBtn) {
      addToCartBtn.style.opacity = itemCount >= CART_LIMIT ? '0.5' : '1';
      addToCartBtn.style.pointerEvents = itemCount >= CART_LIMIT ? 'none' : 'auto';
    }
    productCardBtns.forEach(btn => {
      btn.style.opacity = itemCount >= CART_LIMIT ? '0.5' : '1';
      btn.style.pointerEvents = itemCount >= CART_LIMIT ? 'none' : 'auto';
    });
    if (input) {
      input.max = remaining > 0 ? remaining : 0;
      input.value = Math.min(parseInt(input.value) || 1, remaining > 0 ? remaining : 0);
      input.oninput = function() {
        if (parseInt(this.value) > remaining) this.value = remaining > 0 ? remaining : 0;
        if (parseInt(this.value) < 1) this.value = 1;
      };
    }
    document.querySelectorAll('[li-element="mini-cart-item-increase"]').forEach(btn => {
      btn.style.opacity = itemCount >= CART_LIMIT ? '0.5' : '1';
      btn.style.pointerEvents = itemCount >= CART_LIMIT ? 'none' : 'auto';
    });
  }
  fetch('/cart.js')
    .then(r => r.json())
    .then(data => updateCartLimit(data.item_count));
  window.addEventListener('carttotalitems', function(e) {
    updateCartLimit(e.detail);
  });
  const observer = new MutationObserver(() => {
    fetch('/cart.js')
      .then(r => r.json())
      .then(data => updateCartLimit(data.item_count));
  });
  observer.observe(document.body, { childList: true, subtree: true });
</script>
    <script>
  document.addEventListener('DOMContentLoaded', function() {
  const priceEl = document.getElementById('price');
  const perStukEl = document.getElementById('perstuk');
  if (priceEl && perStukEl) {
    const price = parseFloat(priceEl.textContent.replace(',', '.'));
    const perStuk = price / 6;
    perStukEl.textContent = perStuk.toFixed(2);
  }
});
</script>
