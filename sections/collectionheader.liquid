<div class="padding_5">
          <div class="flex-outside title">
            <div class="title-cont">
              <div class="small-tag">
                <div class="button-background w-embed"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 160.917 54.977" width="100%" height="100%" preserveaspectratio="none">
                    <path d="M.176,10.8,6.938,47.713s64.278,3.9,89.154,0S148.044,43.3,148.044,43.3,163.629,9.658,158.1,2.609,68.452,4.885,61.637,6.158.57,4.779.176,7.234A7.969,7.969,0,0,0,.176,10.8Z" transform="translate(1.726) rotate(2)" fill="currentColor"></path>
                  </svg></div>
                <div class="tag-text bigger">
{{ section.settings.text_tag }}
</div>
              </div><img src="{{ 'hartje_klein.png' | asset_url }}" loading="lazy" sizes="100vw" srcset="{{ 'hartje_klein-p-500.png' | asset_url }} 500w, {{ 'hartje_klein-p-800.png' | asset_url }} 800w, {{ 'hartje_klein-p-1080.png' | asset_url }} 1080w, {{ 'hartje_klein-p-1600.png' | asset_url }} 1600w, {{ 'hartje_klein-p-2000.png' | asset_url }} 2000w, {{ 'hartje_klein.png' | asset_url }} 2423w" alt="" class="hartje-relatief">
              <h1 class="h1-collection mid left">
{{ section.settings.text_heading_collections }}
</h1>
              <div class="image-container"><img src="{{ 'maryam.png' | asset_url }}" loading="lazy" alt="" class="lm" img="{{ section.settings.img_little_maryam_pop }}"></div>
            </div>
            <div class="_500px">
              <p li-object="collection.description" class="text-size-regular paragraph small">{{ collection.description }}</p>
            </div>
          </div>
        </div><img src="{{ 'wolkjepaars.png' | asset_url }}" loading="lazy" sizes="100vw" srcset="{{ 'wolkjepaars-p-500.png' | asset_url }} 500w, {{ 'wolkjepaars.png' | asset_url }} 609w" alt="" class="smallcloud right below"> {% schema %} {
    "tag": "section",
    "name": "collectionheader",
    "class": "collection-header",
    "settings": [
        {
            "id": "text_tag",
            "type": "text",
            "label": "Tag",
            "default": "sinds 2019"
        },
        {
            "id": "text_heading_collections",
            "type": "text",
            "label": "Heading collections",
            "default": "Wereldse smaken<br\/>met liefde bereid"
        },
        {
            "id": "img_little_maryam_pop",
            "type": "text",
            "label": "Little Maryam Pop"
        }
    ],
    "presets": [
        {
            "name": "collectionheader",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}