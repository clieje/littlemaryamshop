<div class="padding_5">
          <div class="container-large big">
            <div class="product-header_component">
              {% unless template.name == 'index' %}    <ul li-unless="template.name == 'index'" role="list" class="breadcrumb">
    
                {% if template == 'product' %}    <li li-if="template == 'product'" class="breadcrum_item">
    
                  <a href="#" class="w-inline-block">
                    <div class="small-text">
{{ section.settings.text_producten }}
</div>
                  </a><img src="{{ 'hartje_klein.png' | asset_url }}" loading="lazy" sizes="(max-width: 2423px) 100vw, 2423px" srcset="{{ 'hartje_klein-p-500.png' | asset_url }} 500w, {{ 'hartje_klein-p-800.png' | asset_url }} 800w, {{ 'hartje_klein-p-1080.png' | asset_url }} 1080w, {{ 'hartje_klein-p-1600.png' | asset_url }} 1600w, {{ 'hartje_klein-p-2000.png' | asset_url }} 2000w, {{ 'hartje_klein.png' | asset_url }} 2423w" alt="" class="hartje-kleinst">
                    </li>
{% endif %}
                {% if template == 'product' %}    <li li-if="template == 'product'" class="breadcrum_item">
    
                  <div li-object="product.title" class="small-text">{{ product.title }}</div>
                    </li>
{% endif %}
                  </ul>
{% endunless %}
              <script src="{{ 'li_custom.js' | asset_url }}" type="text/javascript"></script>
<div li-element="product-variant-container" class="w-layout-grid product-header_layout" x-data="handleVariant({{ product | json | escape }}, {{ product.options_by_name | json | escape }}, {{ product.selected_or_first_available_variant | json | escape }})" x-init="$nextTick(() => { activateVariants() })" @setbundleitem.window="updateBundleItem($event.detail.product, $event.detail.quantity)">
                <div id="w-node-fe548112-1dd8-9dee-4669-09e4aeb677a0-9580fc58" class="swiper-container is-product-gallery">
                  <div class="swiper is-product-gallery">
                    <div id="my-gallery" li-for:inside="media in product.media" class="swiper-wrapper is-product-gallery">
        {% for media in product.media %}                            
                      
                            {% if media.media_type == 'image' and forloop.first == false %}    <div li-if="media.media_type == 'image' and forloop.first == false" class="swiper-slide is-product-gallery">
    
                        <div class="product-header_gallery-lightbox-3"><img li-object:src="media | image_url: width: 1000" li-object:alt="media.alt" alt="{{ media.alt }}" src="{{ media | image_url: width: 1000 }}" loading="lazy" class="product-header_gallery-image-3"></div>
                          </div>
{% endif %}
                            
                      
                            {% if media.media_type == 'video' %}    <div li-if="media.media_type == 'video'" class="swiper-slide is-product-gallery">
    
                        <div class="product-header_gallery-lightbox-3">
                          <div li-object="media | video_tag: controls: true" class="product-header_gallery-image-3">{{ media | video_tag: controls: true }}</div>
                        </div>
                          </div>
{% endif %}
                            
                    
                    {% endfor %}    </div>
                  </div>
                  <div class="product-header_slider-wrapper-3">
                    <div class="swiper_button-wrapper is-product-slider pointer-events-off z-index-1 hide-mobile-landscape"></div>
                    <div class="swiper is-product-thumbnail">
                      <div li-for:inside="media in product.media" class="swiper-wrapper is-product-thumbnail _1">
        {% for media in product.media %}                            
                        
                            {% if media.media_type == 'image'  and forloop.first == false %}    <div li-if="media.media_type == 'image'  and forloop.first == false" class="swiper-slide is-product-thumbnail">
    <img li-object:src="media | image_url: width: 200" li-object:alt="media.alt" alt="{{ media.alt }}" src="{{ media | image_url: width: 200 }}" loading="lazy" class="product-header_thumbnail-image-3">    </div>
{% endif %}
                            
                        
                            {% if media.media_type == 'video' %}    <div li-if="media.media_type == 'video'" class="swiper-slide is-product-thumbnail">
    <img li-object:src="media | image_url: width: 200" li-object:alt="media.alt" alt="{{ media.alt }}" src="{{ media | image_url: width: 200 }}" loading="lazy" class="product-header_thumbnail-image-3">
                          <div aria-hidden="true" class="product-header_play-icon w-embed"><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" aria-hidden="true" role="img" class="iconify iconify--ic" width="100%" height="100%" preserveaspectratio="xMidYMid meet" viewbox="0 0 24 24">
                              <path fill="currentColor" d="M8 5v14l11-7z"></path>
                            </svg></div>
                            </div>
{% endif %}
                            
                      
                    {% endfor %}    </div>
                    </div>
                  </div>
                  <div class="swiper-slide is-product-thumbnail is-active hide"></div>
                  <div style="color: {{ product.metafields.custom.color }}" class="icons-product">
                    <div class="icon-test">
                      <div style="text-color: {{ product.metafields.custom.color }}" class="maanden-tekst">
                        <div class="halalsvg w-embed"><svg id="Group_17" data-name="Group 17" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="100%" height="100%" viewbox="0 0 67.218 58.025">
                            <defs>
                              <clippath id="clip-path">
                                <rect id="Rectangle_16" data-name="Rectangle 16" width="67.218" height="37.853" fill="CurrentColor"></rect>
                              </clippath>
                            </defs>
                            <g id="Group_16" data-name="Group 16" transform="translate(0 0)" clip-path="url(#clip-path)">
                              <path id="Path_9" data-name="Path 9" d="M50.178,19.369a13.217,13.217,0,0,1,9.978,12.939c.009.5.138.71-.492.61-1.415-4.085-5.012-7.367-9.486-7.5Z" transform="translate(-25.778 -9.95)" fill="CurrentColor"></path>
                              <path id="Path_10" data-name="Path 10" d="M19.692,0l3.962,4.49L21.741,7.377c-.362,6.245.427,12.919-.006,19.111-.569,8.143-7.467,12.706-15.381,10.933-8.57-1.92-7.682-12.715-2.01-17.35-1,4.065-1.357,8.6,2.519,11.278,2.552,1.76,5.736,2.312,8.3.217,5.526-4.511,1.858-19.482.709-25.653C15.963,4.787,18.9.14,19.692,0" transform="translate(0 0)" fill="CurrentColor"></path>
                              <path id="Path_11" data-name="Path 11" d="M60.989,23.991l-1.763,5.626c-1.589,4.228-5.735,11.152-9.982,13.053-3.681,1.648-7.728.909-11.594.678-.126-.689.17-.4.533-.544A49.033,49.033,0,0,0,43.4,40.487c10.627-5.824,16.445-17.049,15.885-29.078l4.39,1.6.475,20.053c.312,7.972,9.243,8.669,13.23,2.77,1.017-1.5,1.336-1.95-.523-2.833a7.769,7.769,0,0,0-6.517-.3A21.71,21.71,0,0,0,67.8,34.278c2.337-7.867,10.3-6.314,16.047-3.154a22.861,22.861,0,0,1,2.687,1.719.942.942,0,0,1-.249.719c-4.032,6.023-16.73,14.49-22.861,7-.943-1.151-2.437-4.374-2.437-5.8Z" transform="translate(-19.327 -5.861)" fill="CurrentColor"></path>
                            </g>
                            <path id="Path_98" data-name="Path 98" d="M7.308-3.934H3.332V0H1.176V-9.8H3.332v3.878H7.308V-9.8H9.464V0H7.308ZM18.214-2.2H14.07l-.9,2.2h-2.2l4.2-9.87h1.988L21.364,0H19.11ZM14.84-4.1h2.6l-1.3-3.178Zm8.036-5.7h2.156v7.84h4.886V0H22.876ZM37.94-2.2H33.8L32.9,0H30.7l4.2-9.87H36.89L41.09,0H38.836ZM34.566-4.1h2.6l-1.3-3.178ZM42.6-9.8h2.156v7.84h4.886V0H42.6Z" transform="translate(10.906 58.025)" fill="CurrentColor"></path>
                          </svg></div>
                      </div>
                    </div>
                    <div class="icon-test extraspace"><text style="text-color: {{ product.metafields.custom.color }}" class="maanden-tekst">bio</text></div>
                    <div class="icon-test"><text li-oject:text="product.metafields.custom.maanden" class="maanden-tekst">14+</text><text li-object:text="product.metafields.custom.maandentekst" style="text-color: {{ product.metafields.custom.color }}" class="maand-tekst">
{{ product.metafields.custom.maandentekst }}
</text></div>
                  </div>
                </div>
                <div li-cf-theme-blocks="theme" id="w-node-e206aa1f-c6a7-a112-f7c6-30bd6839644e-9580fc58" class="product-header_product-details">
{% content_for 'blocks' %}
</div>
              </div>
            </div>
          </div>
        </div>
        <div class="hide w-embed w-script">
          <script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
          <script>
document.addEventListener("DOMContentLoaded", () => {
  $(".swiper-container").each(function (index) {
    const thumbsSwiper = new Swiper($(this).find(".swiper.is-product-thumbnail")[0], {
      slidesPerView: "auto",
      rewind: false,
      loopedSlides: 8,
      slideToClickedSlide: true,
      spaceBetween: "4%",
    });
    const swiper = new Swiper($(this).find(".swiper.is-product-gallery")[0], {
      mousewheel: {
        forceToAxis: true
      },
      thumbs: {
        swiper: thumbsSwiper,
        slideThumbActiveClass: "is-active",
      },
      keyboard: {
        enabled: true,
        onlyInViewport: true
      },
      navigation: {
        nextEl: $(this).find(".swiper-next")[0],
        prevEl: $(this).find(".swiper-prev")[0],
      }
    });
  }); 
});
</script>
        </div> {% schema %} {
    "tag": "section",
    "name": "Product Header",
    "class": "section_product-header",
    "blocks": [
        {
            "type": "@theme"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_producten",
            "type": "text",
            "label": "Producten",
            "default": "Producten"
        }
    ],
    "presets": [
        {
            "name": "Product Header",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "product-name"
                },
                {
                    "type": "product-price"
                },
                {
                    "type": "description"
                },
                {
                    "type": "add-to-cart"
                }
            ]
        }
    ],
    "enabled_on": {
        "templates": [
            "product"
        ]
    }
} {% endschema %}